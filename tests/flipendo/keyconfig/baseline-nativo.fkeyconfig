# Linea base de la configuracion de teclado exportada como DATOS.
# La genera --fl-check-keyconfig-io y sirve para ver de un vistazo, en un
# diff, si un cambio del arbol mueve un atajo sin querer.
fkeyconfig 1
version 4 5 85
keymap "3D View" space=VIEW_3D region=WINDOW
item "VIEW3D_OT_cursor3d" type=RIGHTMOUSE value=PRESS shift=1
