fpreset 1
subdir render
set context.scene.render.resolution_x 1440
set context.scene.render.resolution_y 1080
set context.scene.render.resolution_percentage 100
set context.scene.render.pixel_aspect_x 4
set context.scene.render.pixel_aspect_y 3
set context.scene.render.fps 25
set context.scene.render.fps_base 1
