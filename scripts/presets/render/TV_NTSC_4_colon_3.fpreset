fpreset 1
subdir render
set context.scene.render.resolution_x 720
set context.scene.render.resolution_y 486
set context.scene.render.resolution_percentage 100
set context.scene.render.pixel_aspect_x 10
set context.scene.render.pixel_aspect_y 11
set context.scene.render.fps 30
set context.scene.render.fps_base 1.001
