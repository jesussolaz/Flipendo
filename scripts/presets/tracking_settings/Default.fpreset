fpreset 1
subdir tracking_settings
set context.edit_movieclip.tracking.settings.default_pattern_size 21
set context.edit_movieclip.tracking.settings.default_search_size 71
set context.edit_movieclip.tracking.settings.default_motion_model "Loc"
set context.edit_movieclip.tracking.settings.use_default_brute true
set context.edit_movieclip.tracking.settings.use_default_normalization false
set context.edit_movieclip.tracking.settings.use_default_mask false
set context.edit_movieclip.tracking.settings.default_frames_limit 0
set context.edit_movieclip.tracking.settings.default_pattern_match "KEYFRAME"
set context.edit_movieclip.tracking.settings.default_margin 0
set context.edit_movieclip.tracking.settings.use_default_red_channel true
set context.edit_movieclip.tracking.settings.use_default_green_channel true
set context.edit_movieclip.tracking.settings.use_default_blue_channel true
set context.edit_movieclip.tracking.settings.default_correlation_min 0.75
set context.edit_movieclip.tracking.settings.default_weight 1.0
