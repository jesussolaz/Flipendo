fpreset 1
subdir cloth
set context.cloth.settings.quality 5
set context.cloth.settings.mass 0.15
set context.cloth.settings.tension_stiffness 5
set context.cloth.settings.compression_stiffness 5
set context.cloth.settings.shear_stiffness 5
set context.cloth.settings.bending_stiffness 0.05
set context.cloth.settings.tension_damping 0
set context.cloth.settings.compression_damping 0
set context.cloth.settings.shear_damping 0
set context.cloth.settings.air_damping 1
