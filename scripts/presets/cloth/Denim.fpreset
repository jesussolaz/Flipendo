fpreset 1
subdir cloth
set context.cloth.settings.quality 12
set context.cloth.settings.mass 1
set context.cloth.settings.tension_stiffness 40
set context.cloth.settings.compression_stiffness 40
set context.cloth.settings.shear_stiffness 40
set context.cloth.settings.bending_stiffness 10
set context.cloth.settings.tension_damping 25
set context.cloth.settings.compression_damping 25
set context.cloth.settings.shear_damping 25
set context.cloth.settings.air_damping 1
