fpreset 1
subdir cloth
set context.cloth.settings.quality 15
set context.cloth.settings.mass 0.4
set context.cloth.settings.tension_stiffness 80
set context.cloth.settings.compression_stiffness 80
set context.cloth.settings.shear_stiffness 80
set context.cloth.settings.bending_stiffness 150
set context.cloth.settings.tension_damping 25
set context.cloth.settings.compression_damping 25
set context.cloth.settings.shear_damping 25
set context.cloth.settings.air_damping 1
